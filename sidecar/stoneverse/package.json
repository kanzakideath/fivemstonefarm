{
  "name": "stoneverse-sidecar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:host": "vite build --config vite.host.config.ts",
    "test:host": "vitest run src/host/farmHostBridge.test.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:simulation": "vitest run src/domain/core.simulation.test.ts",
    "test:advanced-simulation": "vitest run src/domain/advanced/advancedSimulation.test.ts src/domain/advanced/endlessMine.test.ts",
    "test:idle-simulation": "vitest run src/domain/idle.test.ts src/domain/expedition.test.ts src/domain/endlessCampaign.test.ts src/store/backgroundStore.test.ts src/store/endlessMastery.integration.test.ts",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "lucide-react": "0.544.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "7.3.6",
    "typescript": "5.9.3",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "26.1.0",
    "playwright-core": "1.63.0",
    "vitest": "5.0.0"
  }
}
